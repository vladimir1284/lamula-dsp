# Plantilla de configuración de `lamula-dsp` (`crates/service::config::ServiceConfig`).
# Ninguna de estas variables tiene valor por defecto — el binario se niega a
# arrancar si falta cualquiera (`ConfigError`, ver `crates/service/src/config.rs`).
# Copiar a /etc/lamula-dsp/lamula-dsp.env (permisos 0640, dueño del usuario de
# servicio) y completar con los valores reales de la instalación — ninguno de
# los de abajo es válido tal cual, son placeholders.

# --- Direcciones de escucha -------------------------------------------------
# El DSP escucha (servidor) en las dos: el DRx conecta como cliente
# (supuesto sin confirmar contra el proyecto DRx, ver
# crates/ingest/src/tcp.rs), y también el RCP.
LAMULA_DSP_DRX_ADDR=0.0.0.0:5000
LAMULA_DSP_RCP_ADDR=0.0.0.0:5001

# --- Convención de cuantización I/Q -----------------------------------------
# Cuenta ADC a la que se mapea una componente I o Q de amplitud unitaria.
# Convención de este repositorio, sin calibración real confirmada todavía
# (ver crates/ingest/src/wire.rs, doc-comment de decode_ray_frame).
LAMULA_DSP_FULL_SCALE_COUNTS=32767

# --- Encoder SSI de acimut/elevación -----------------------------------------
# Resolución (cuentas por vuelta completa) y offset de cero del encoder SSI
# del hardware real — ninguno de los dos está documentado en este repositorio
# (ver crates/ingest/src/angle.rs).
LAMULA_DSP_SSI_COUNTS_PER_TURN=4096
LAMULA_DSP_SSI_ZERO_OFFSET_DEG=0.0

# --- NCO de recepción del DRx (lazo de AFC) ----------------------------------
# NINGUNO de los dos viene de ningún contrato de este repositorio (ni
# DRx<->DSP ni DSP<->RCP exponen el reloj de referencia ni la anchura del
# acumulador de fase del NCO de recepción) — confirmar contra la
# especificación de hardware del proyecto DRx antes de comisionar el lazo de
# AFC contra hardware real. Ver crates/burst/src/afc.rs,
# docs/algorithms/roadmap.md "Decisiones cerradas" > "Lazo de AFC".
LAMULA_DSP_DRX_NCO_FS_HZ=250000000.0
LAMULA_DSP_DRX_NCO_WORD_BITS=32

# --- Lazo de AFC, parámetros de instalación ----------------------------------
# Constante de tiempo del filtro de primer orden (segundos — la deriva de un
# magnetrón es lenta, del orden de segundos, no de milisegundos) y umbral de
# amplitud de burst bajo el cual el lazo se congela y se marca BITE. Ver
# lamula_burst::AfcLoop.
LAMULA_DSP_AFC_TAU_S=2.0
LAMULA_DSP_AFC_AMP_THRESHOLD=0.05
